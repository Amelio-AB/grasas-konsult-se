{
  "name": "engstroms-konsulter-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=engstroms-konsulter",
    "build:website": "npm run build --workspace=engstroms-konsulter",
    "check:website": "npm run check --workspace=engstroms-konsulter",
    "dev:admin": "npm run dev --workspace=engstroms-admin",
    "build:admin": "npm run build --workspace=engstroms-admin",
    "lint:admin": "npm run lint --workspace=engstroms-admin"
  }
}
