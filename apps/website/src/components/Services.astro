---
import RouteIllustration from './illustrations/RouteIllustration.astro';
import OfficeIllustration from './illustrations/OfficeIllustration.astro';

const trafficServices = [
  'Väg- och trafikutredningar',
  'Trafiksäkerhetsanalyser',
  'Väg- och sträckbedömningar',
  'Rådgivning och projektledning',
  'Projektering och infrastrukturplanering',
  'Cykelinfrastruktur och utbildning',
];

const officeServices = [
  'Kontorsservice',
  'Receptionsstöd',
  'Tillfällig administrativ förstärkning',
  'Semesterersättning',
  'Stöd vid sjukfrånvaro eller annan ledighet',
];
---

<section id="tjanster" class="services" aria-labelledby="services-title">
  <div class="container">
    <header class="services-header">
      <div>
        <p class="eyebrow">Våra tjänster</p>
        <h2 id="services-title" class="section-heading">Två områden.<br />Samma ansvar.</h2>
      </div>
      <p>
        Kompetens för både planerade uppdrag och situationer där rätt förstärkning behövs med kortare framförhållning.
      </p>
    </header>

    <div class="service-list">
      <article class="service service-dark">
        <div class="service-number">01 <span></span></div>
        <div class="service-title">
          <p>Göran Engström</p>
          <h3>Väg &<br />trafik</h3>
          <RouteIllustration />
        </div>
        <div class="service-content">
          <p class="service-intro">
            Konsultstöd från analys och tidig planering till genomgång av vägar, sträckor och trafiksäkerhet.
          </p>
          <ul>
            {trafficServices.map((service) => <li>{service}</li>)}
          </ul>
          <aside>
            <span>På väg</span>
            Göran har beskrivit ett kommande uppdrag där specialsträckor och vägar inför Bauhaus Rally ska gås igenom.
          </aside>
        </div>
      </article>

      <article class="service service-light">
        <div class="service-number">02 <span></span></div>
        <div class="service-title">
          <p>Annika Engström</p>
          <h3>Kontors&shy;service</h3>
          <OfficeIllustration />
        </div>
        <div class="service-content">
          <p class="service-intro">
            Flexibel och personlig avlastning som hjälper kontoret eller receptionen att fortsätta fungera när ordinarie personal inte är på plats.
          </p>
          <ul>
            {officeServices.map((service) => <li>{service}</li>)}
          </ul>
          <aside>
            <span>När det behövs</span>
            Praktisk förstärkning vid semester, sjukfrånvaro och annan ledighet.
          </aside>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-space) 0;
    background: #ebe6dc;
  }

  .services-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 29rem);
    align-items: end;
    gap: 3rem;
    margin-bottom: clamp(3.25rem, 5vw, 4.75rem);
  }

  .services-header > p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .service-list {
    display: grid;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .service {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(15rem, 0.75fr) minmax(20rem, 1.25fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    padding: clamp(2.5rem, 4vw, 4rem);
    overflow: hidden;
  }

  .service-dark {
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .service-light {
    border-left: 3px solid transparent;
    background: var(--color-surface);
  }

  .service-number {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .service-number span {
    width: 2rem;
    height: 1px;
    margin-top: 0.55rem;
    background: currentColor;
  }

  .service-title p {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .service-title {
    align-self: start;
  }

  .service-dark .service-title p {
    color: var(--color-text-muted);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .service-content {
    max-width: 37rem;
  }

  .service-intro {
    margin: 0 0 2rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .service-dark .service-intro {
    color: var(--color-text);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.75rem 1rem 0.75rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .service-dark li {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  aside {
    margin-top: 2.25rem;
    padding: 1.1rem 0 0 1.1rem;
    border-top: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .service-dark aside {
    border-top-color: var(--color-border);
    color: var(--color-text-muted);
  }

  aside span {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1020px) {
    .service {
      grid-template-columns: 3.5rem minmax(13rem, 0.7fr) minmax(18rem, 1.3fr);
      gap: 2rem;
    }
  }

  @media (max-width: 820px) {
    .services-header,
    .service {
      grid-template-columns: 1fr;
    }

    .services-header {
      align-items: start;
    }

    .services-header > p {
      max-width: 35rem;
    }

    .service {
      gap: 2rem;
      padding-block: 2.75rem;
    }

    .service-title {
      padding-bottom: 2rem;
      border-bottom: 1px solid currentColor;
    }

  }

  @media (max-width: 520px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
