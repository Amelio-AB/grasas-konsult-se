---
import BrandLogo from './BrandLogo.astro';
---

<header class="site-header" data-header>
  <div class="header-inner container">
    <a class="brand-link" href="#top" aria-label="Engströms Konsulter – startsida">
      <BrandLogo />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="menu-label">Meny</span>
      <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Huvudnavigation">
      <a href="#tjanster">Tjänster</a>
      <a href="#arbetssatt">Arbetssätt</a>
      <a href="#om">Om oss</a>
      <a class="nav-contact" href="#kontakt">Kontakt <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuButton = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('.primary-nav');

  const closeMenu = () => {
    menuButton?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('menu-active');
    document.body.classList.remove('menu-open');
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    header?.classList.toggle('menu-active', !isOpen);
    document.body.classList.toggle('menu-open', !isOpen);
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      menuButton?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid var(--color-border-dark);
    color: var(--color-bg);
  }

  .header-inner {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: block;
    line-height: 0;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.35rem, 2.2vw, 2.5rem);
  }

  .primary-nav a {
    color: var(--color-light-muted);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .primary-nav a:hover {
    color: var(--color-accent);
  }

  .primary-nav .nav-contact {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    gap: 1rem;
    padding: 0 0.9rem;
    border: 1px solid var(--color-border-dark);
    color: var(--color-bg);
  }

  .primary-nav .nav-contact:hover {
    border-color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 780px) {
    .header-inner {
      min-height: 5.25rem;
    }

    .menu-toggle {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.75rem 0;
      border: 0;
      background: transparent;
      color: var(--color-bg);
      font: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      cursor: pointer;
    }

    .menu-lines {
      display: grid;
      width: 1.45rem;
      gap: 0.35rem;
    }

    .menu-lines i {
      display: block;
      height: 1px;
      background: currentColor;
      transition: transform var(--transition-fast);
    }

    .menu-active .menu-lines i:first-child {
      transform: translateY(3px) rotate(45deg);
    }

    .menu-active .menu-lines i:last-child {
      transform: translateY(-3px) rotate(-45deg);
    }

    .primary-nav {
      position: fixed;
      inset: 0;
      display: flex;
      visibility: hidden;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1.2rem;
      padding: 7rem var(--gutter) 3rem;
      background: var(--color-dark);
      opacity: 0;
      transform: translateY(-1rem);
      transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base);
    }

    .menu-active .primary-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .primary-nav a {
      font-family: var(--font-sans);
      font-size: clamp(1.65rem, 7vw, 2.4rem);
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.2;
      text-transform: none;
    }

    .primary-nav .nav-contact {
      min-height: auto;
      padding: 0;
      border: 0;
      color: var(--color-accent);
    }
  }
</style>
