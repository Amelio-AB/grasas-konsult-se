---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['brand-logo', className]}>
  <img
    src="/images/engstroms-konsulter-logo-light.png"
    alt="Engströms Konsulter"
    width="1254"
    height="313"
  />
</span>

<style>
  .brand-logo {
    display: block;
    width: clamp(14rem, 20vw, 18rem);
    line-height: 0;
  }

  .brand-logo img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 600px) {
    .brand-logo {
      width: 12.5rem;
    }
  }
</style>
