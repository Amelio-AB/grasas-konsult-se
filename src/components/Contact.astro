<section id="kontakt" class="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-intro">
      <p class="eyebrow">Kontakt</p>
      <h2 id="contact-title">Har du ett uppdrag<br />att prata om?</h2>
      <p>
        Börja med ett samtal. Berätta vad verksamheten behöver, så ser vi tillsammans på nästa steg.
      </p>
    </div>

    <div class="contact-content">
      <form class="contact-form" data-contact-form aria-describedby="form-note" autocomplete="on">
        <header class="form-heading">
          <h3>Skicka en förfrågan</h3>
          <p>Fyll i uppgifterna nedan, så har vi ett bra underlag för ett första samtal.</p>
        </header>

        <div class="form-fields">
          <div class="form-field">
            <label for="contact-name">Namn <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="form-field">
            <label for="contact-email">E-post <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="form-field form-field-wide">
            <label for="contact-phone">Telefon <small>valfritt</small></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div class="form-field form-field-wide">
            <label for="contact-message">Vad kan vi hjälpa dig med? <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>
        </div>

        <div class="form-footer">
          <button class="button" type="submit">Skicka förfrågan</button>
          <p id="form-note" class="form-note">
            Kunddemo: formuläret skickar ännu inga meddelanden.
          </p>
          <p class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></p>
        </div>
      </form>

      <section class="personal-contact" aria-labelledby="personal-contact-title">
        <div class="personal-contact-heading">
          <h3 id="personal-contact-title">Personlig kontakt</h3>
          <p>Vill du hellre skriva direkt?</p>
        </div>

        <div class="contact-people">
          <article class="contact-person">
            <span class="person-mark" aria-hidden="true">GE</span>
            <div>
              <h4>Göran Engström</h4>
              <p>Väg- och trafikkonsult</p>
              <a href="mailto:goran@engkons.se">goran@engkons.se <span aria-hidden="true">→</span></a>
            </div>
          </article>

          <article class="contact-person">
            <span class="person-mark" aria-hidden="true">AE</span>
            <div>
              <h4>Annika Engström</h4>
              <p>Kontorsservice</p>
              <a href="mailto:annika@engkons.se">annika@engkons.se <span aria-hidden="true">→</span></a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const formStatus = contactForm?.querySelector<HTMLElement>('[data-form-status]');

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    // TODO: Koppla formuläret till en verifierad backend eller formulärtjänst före publicering.
    if (formStatus) {
      formStatus.textContent = 'Ingen förfrågan skickades. Formuläret kopplas in före publicering.';
      formStatus.focus();
    }
  });
</script>

